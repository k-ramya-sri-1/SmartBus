
# Environment secrets
**/.env
**/.env.*
!**/.env.example

# Node.js dependencies and build output
**/node_modules/
**/dist/
**/dist-ssr/

# Logs
logs/
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment files
**/*.local

# Python
**/__pycache__/
*.py[cod]
**/.venv/
**/venv/

# Editor and operating system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# SmartBus: local artefacts that must never be committed
database/backups/
.tmp/
face-service/models/*.onnx
face-service/data/
esp32/SmartBus-ESP32/include/device_secrets.h
esp32/SmartBus-ESP32/include/wifi_config.h
