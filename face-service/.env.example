# SmartBus face service configuration (copy to .env and fill in)
#
# Shared secret between the backend and this service. Must be identical to
# FACE_SERVICE_SECRET in backend/.env. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FACE_SERVICE_SECRET=

FACE_SERVICE_HOST=127.0.0.1
FACE_SERVICE_PORT=8001

# SFace cosine similarity threshold. 0.363 is the value published with the
# model; raise it to be stricter (fewer false accepts) and lower it to be more
# forgiving (fewer false rejects).
FACE_MATCH_THRESHOLD=0.363

FACE_MODEL_DIR=models
FACE_TEMPLATE_DIR=data/templates
LOG_LEVEL=INFO
